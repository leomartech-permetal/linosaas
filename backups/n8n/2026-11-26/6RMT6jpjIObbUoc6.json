        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1344,
          240
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item, index) => {\n  const source = $('Extrair mensagens do número oficial').itemMatching(index).json;\n  const data = item.json.attachment_base64;\n  if (source.media_id && typeof data !== 'string') throw new Error('Mídia Meta sem conteúdo');\n  return {json: {\n    sender: source.sender, message_id: source.message_id, message: source.message,\n    meta_reply_to: source.meta_reply_to, meta_button_id: source.meta_button_id,\n    attachments: source.media_id ? [{ id: source.media_id, name: source.filename, type: source.media_type, data }] : [],\n  }, pairedItem: { item: index }};\n});"
        }
