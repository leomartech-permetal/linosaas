      {
        "id": "fa4db341-ff47-4b62-b2dd-4452610ad96a",
        "name": "Extrair mensagens do número oficial",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          240
        ],
        "parameters": {
          "jsCode": "const allowed = new Set(['text','audio','image','document','interactive','button']);\nreturn $input.all().flatMap(({ json: event }, index) => {\n  if (String(event.metadata?.phone_number_id) !== \"1368022049723472\"\n      || !Array.isArray(event.messages)) return [];\n  return event.messages.flatMap(message => {\n    if (!message || !allowed.has(message.type) || !/^\\d{10,15}$/.test(message.from ?? '')\n        || !/^wamid\\.[\\w+=/-]{1,490}$/.test(message.id ?? '')) return [];\n    const media = ['audio','image','document'].includes(message.type) ? message[message.type] : null;\n    const text = message.text?.body ?? message.interactive?.button_reply?.title\n      ?? message.interactive?.list_reply?.title ?? message.button?.text ?? media?.caption ?? '';\n    if (!text.trim() && !media?.id) return [];\n    return [{ json: {\n      sender: message.from, message_id: message.id, message: text,\n      meta_reply_to: typeof message.context?.id === 'string' ? message.context.id : null,\n      meta_button_id: message.interactive?.button_reply?.id ?? message.button?.payload ?? null,\n      media_id: media?.id ?? null, media_type: media?.mime_type ?? '',\n      filename: media?.filename ?? 'anexo-' + message.type,\n    }, pairedItem: { item: index } }];\n  });\n});"
        }
      },
