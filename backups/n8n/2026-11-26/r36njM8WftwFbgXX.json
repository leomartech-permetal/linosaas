        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst session = String(body.session_id ?? body.sessionId ?? '').trim();\nconst messageKey = String(body.message_id ?? body.messageId ?? '').trim();\nconst message = String(body.message ?? body.text ?? '').trim();\nconst rawList = Array.isArray(body.attachments) ? body.attachments : (body.attachment ? [body.attachment] : []);\nconst attachments = rawList.filter(a => a && typeof a === 'object').map(a => {\n  let data = typeof a.data === 'string' && a.data.trim() ? a.data.trim()\n    : (typeof a.base64 === 'string' && a.base64.trim() ? a.base64.trim() : '');\n  if (!data && typeof a.text_content === 'string' && a.text_content.trim()) {\n    data = Buffer.from(a.text_content, 'utf8').toString('base64');\n  }\n  return {\n    name: String(a.name || a.filename || 'anexo'),\n    type: String(a.type || a.mime_type || a.mimeType || 'application/octet-stream'),\n    data,\n  };\n}).filter(a => a.data.length > 0);\n\nif (!session || session.length > 200 || !messageKey || messageKey.length > 200) {\n  throw new Error('Identificação da mensagem ou da sessão inválida');\n}\nif (!message && !attachments.length) throw new Error('Mensagem vazia');\n\nreturn [{ json: {\n  channel: 'sitechat',\n  conversation_key: session,\n  message_key: messageKey,\n  message,\n  attachments,\n} }];"
        }
