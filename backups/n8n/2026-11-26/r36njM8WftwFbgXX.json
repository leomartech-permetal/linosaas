        ],
        "parameters": {
          "jsCode": "const result = $('Executar motor Lino-Codex').first().json;\nconst input = $('Normalizar entrada do LinoChat').first().json;\nconst identity = { session_id: input.conversation_key, message_id: input.message_key };\nconst answer = result.answer ?? {};\nif (answer.silent === true) return [{json:{...identity,ok:true,silent:true,status:'operator_active',message:''}}];\nconst parts = [...new Set([answer.text, answer.commercial_text]\n  .filter(text => typeof text === 'string' && text.trim())\n  .map(text => text.trim()))];\n\nif (!parts.length) {\n  return [{ json: {\n    ...identity,\n    ok: false,\n    status: result.status || 'unavailable',\n    retryable: result.retryable === true || result.status === 'waiting',\n  } }];\n}\nreturn [{ json: {\n  ...identity,\n  ok: true,\n  message: parts.join('\\n\\n'),\n  opportunity_id: result.opportunity_id ?? null,\n  handoff_pending: Boolean(result.opportunity_id),\n} }];"
