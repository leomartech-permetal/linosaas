      {
        "id": "5efe45ff-9b27-4a8c-9b44-f541a5556065",
        "name": "Montar mensagens aprovadas",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          448,
          96
        ],
        "parameters": {
          "jsCode": "const TEMPLATES = {\n  vendedor: 'lino_suporte_cobranca_vendedor',\n  supervisao: 'lino_supervisao_retorno_pendente',\n  falha: 'lino_suporte_alerta_supervisao',\n  coordenacao: 'lino_suporte_escalacao_coordenacao',\n  pesquisa: 'lino_suporte_pesquisa_atendimento_24h',\n};\n\nfunction campo(value, max, fallback = 'Não informado') {\n  const text = String(value ?? '').replace(/[\\r\\n\\t]+/g, ' ').replace(/ {2,}/g, ' ').trim();\n  if (!text) return fallback;\n  const chars = Array.from(text);\n  return chars.length > max ? chars.slice(0, max - 1).join('') + '…' : text;\n}\n\nfunction montarPedidoMeta(job) {\n  const to = String(job.telefone ?? '');\n  const sellerPhone = String(job.snapshot?.vendedor?.telefone ?? '');\n  if (!/^[1-9][0-9]{9,14}$/.test(to)) throw new Error('destinatario_invalido');\n  const acao = String(job.chave).split(':', 1)[0];\n  const cliente = job.snapshot?.cliente ?? {};\n  const responsavel = campo(job.nome_destino, 48, 'Equipe comercial');\n  const nome = campo(cliente.nome, 60, 'Cliente');\n  const vendedor = campo(job.snapshot?.vendedor?.nome, 60, 'Equipe comercial');\n  const codigo = campo(job.codigo, 60, 'Consulte no Pipeline');\n  const produto = campo(job.snapshot?.produto, 100, 'sua solicitação');\n  const especificacao = campo(job.snapshot?.especificacao, 205);\n  const contato = campo(job.cliente_whatsapp, 17);\n  const dados = [\n    cliente.empresa ? 'Empresa: ' + campo(cliente.empresa, 65) : '',\n    cliente.cnpj ? 'CNPJ: ' + campo(cliente.cnpj, 22) : '',\n    cliente.email ? 'E-mail: ' + campo(cliente.email, 80) : '',\n    job.cliente_whatsapp ? 'WhatsApp: +' + contato : '',\n    job.snapshot?.especificacao ? 'Especificação: ' + campo(job.snapshot.especificacao, 140) : '',\n    job.relato ? 'Cliente disse: “' + campo(job.relato, 115) + '”' : '',\n  ].filter(Boolean).join(' | ');\n  const seguimento = campo([\n    'Cliente relata falta de retorno.',\n    Number.isInteger(job.minutos_uteis) ? 'Tempo útil: ' + job.minutos_uteis + ' min.' : '',\n    'Faltas: ' + Number(job.faltas ?? 0) + '.',\n    dados\n  ].filter(Boolean).join(' '), 430);\n  const template = (name, fields, buttons = []) => ({\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual',\n    to,\n    type: 'template',\n    template: {\n      name, language: {code: 'pt_BR'},\n      components: [{type:'body', parameters: fields.map(text => ({type:'text', text}))}, ...buttons]\n    }\n  });\n  const text = body => ({messaging_product:'whatsapp', recipient_type:'individual', to, type:'text',\n    text:{preview_url:false,body}});\n\n  if (acao === 'confirmacao_cliente' && job.t0 && /^[1-9][0-9]{9,14}$/.test(sellerPhone)) {\n    return text('Seu atendimento foi encaminhado para ' + vendedor + ', responsável pela sua solicitação. ' +\n      'O WhatsApp dele é +' + sellerPhone + '. Você também pode falar diretamente com ele. ' +\n      'Vou continuar acompanhando seu atendimento por aqui.');\n  }\n  if (acao === 'pesquisa_atendimento' && job.t0) {\n    const buttons = ['lino_sla_atendido_sim','lino_sla_atendido_nao'].map((payload,index) =>\n      ({type:'button',sub_type:'quick_reply',index:String(index),parameters:[{type:'payload',payload}]}));\n    return template(TEMPLATES.pesquisa, [nome,codigo,produto,vendedor], buttons);\n  }\n  if (acao === 'complemento_vendedor' || acao === 'pedido_vendedor') {\n    const assunto = acao === 'pedido_vendedor' ? 'Solicitação sobre pedido' : 'Complemento de cotação';\n    return text(assunto + ' ' + codigo + ' de ' + nome + ', sobre ' + produto + '. ' +\n      campo(job.relato,400) + ' Consulte o atendimento no Pipeline do Lino e dê retorno ao cliente.');\n  }\n  if (job.destino === 'vendedor') {\n    return template(TEMPLATES.vendedor, [responsavel,nome,codigo,produto,seguimento]);\n  }\n  if (job.destino === 'coordenacao_comercial') {\n    const contexto = acao === 'falha_notificacao'\n      ? campo('Entrega inicial ainda sem confirmação da Meta. ' + dados, 420)\n      : seguimento;\n    return template(TEMPLATES.coordenacao,[responsavel,nome,vendedor,produto,codigo,contexto]);\n  }\n  if (acao === 'falha_notificacao') {\n    return template(TEMPLATES.falha,[responsavel,codigo,nome,vendedor,produto,\n      campo('A entrega da notificação inicial ao vendedor ainda não foi confirmada. ' + dados,420)]);\n  }\n  if (String(job.destino).startsWith('supervisor_')) {\n    return template(TEMPLATES.supervisao,[responsavel,nome,codigo,produto,especificacao,contato]);\n  }\n  throw new Error('tipo_de_despacho_invalido');\n}\nconst tarefas=$input.first()?.json?.resultado?.tarefas||[];\nif (!Array.isArray(tarefas)) throw new Error('Resposta de reserva inválida');\nreturn tarefas.map(tarefa=>({json:{id:tarefa.id,token:tarefa.token,payload:montarPedidoMeta(tarefa)},pairedItem:{item:0}}));"
        }
      },
      {
        "id": "ea4ec0af-3c50-42b2-8f26-da1fcf294f7d",
        "name": "Classificar envio",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          896,
          96
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item,i)=>{\n  const j=item.json||{}, job=$('Montar mensagens aprovadas').itemMatching(i)?.json;\n  if (!job?.id || !job?.token) throw new Error('Reserva sem vínculo do item');\n  const body=j.body||j;\n  const id=String(body.messages?.[0]?.id||'');\n  const code=Number(body.error?.code||0), statusCode=Number(j.statusCode||0);\n  const knownFailure=Boolean(body.error && (statusCode>=400 && statusCode<500));\n  const retry=knownFailure && (statusCode===429 || [4,17,130429,131056].includes(code));\n  const status=id.startsWith('wamid.')?'aceito':retry?'retry':knownFailure?'falhou':'incerto';\n  return {json:{id:job.id,token:job.token,status,meta_id:id||null,\n    erro:id?null:(code?'meta_'+code:statusCode?'http_'+statusCode:'sem_resposta_meta')},pairedItem:{item:i}};\n});"
        }
